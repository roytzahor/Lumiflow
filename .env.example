# =============================================================================
# LumiFlow — environment template
# Copy to `.env` for local work:  cp .env.example .env
# For a one-shot local stack:    yarn db:up && yarn db:bootstrap && yarn dev
# Cypress against Docker Postgres: yarn test:e2e:local  (ignores DATABASE_URL in .env for the DB step)
# =============================================================================

# --- Database (local Docker default: port 5433, see docker-compose.yml) ---
DATABASE_URL="postgresql://lumiflow:lumiflow@localhost:5433/lumiflow?schema=public"
# Same as DATABASE_URL for local Docker. On Neon: pooled URL here, direct URL below.
DIRECT_URL="postgresql://lumiflow:lumiflow@localhost:5433/lumiflow?schema=public"

# --- Auth (NextAuth) ---
# Generate:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SECRET=""
# Local:
NEXTAUTH_URL="http://localhost:3000"
# Vercel Production: https://your-app.vercel.app  (or your custom domain)
# Vercel Preview:     https://your-app-git-branch-team.vercel.app  (or leave NEXTAUTH_URL unset and set per-deployment — see README)

# --- Google sign-in (optional) ---
# Create OAuth 2.0 credentials: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google  (e.g. http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public URL used in invite links (settings share). Should match the URL users open in the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional ---
CRON_SECRET="optional-secret-for-cron-route"
GEMINI_API_KEY=""
PRISMA_LOG_QUERIES="false"
