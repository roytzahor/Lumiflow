generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  PRIVATE
  SHARED
}

enum AccountMemberRole {
  OWNER
  MEMBER
}

enum RecurringMonthPolicy {
  ROLL_TO_LAST_DAY
  SKIP_MONTH
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id              String          @id @default(uuid())
  name            String?
  email           String          @unique
  passwordHash    String
  onboardingCompletedAt DateTime?
  /// Set when the user finishes or dismisses the post-sign-in dashboard spotlight tour.
  welcomeTourCompletedAt DateTime?
  themePreference ThemePreference @default(SYSTEM)
  /// Collapsed/expanded state for "ריכוז הוצאות קבועות" on dashboard (persisted per user).
  dashboardRecurringSectionExpanded Boolean @default(false)
  /// Collapsed/expanded state for "הפרשות חיסכון החודש" on dashboard (persisted per user).
  dashboardSavingsSectionExpanded Boolean @default(false)
  /// Collapsed/expanded state for "התפלגות הוצאות" (pie) on dashboard (persisted per user).
  dashboardSpendingSectionExpanded Boolean @default(true)
  /// Whether history view lists recurring transactions (toggle "הצג הוצאות קבועות").
  historyShowRecurringTransactions Boolean @default(true)
  /// Collapsible settings page sections (expanded = open).
  settingsProfileSectionExpanded    Boolean @default(true)
  settingsAppearanceSectionExpanded Boolean @default(true)
  settingsAccountsSectionExpanded   Boolean @default(true)
  settingsCategoriesSectionExpanded Boolean @default(true)
  isPremiumMock   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  accountMembers  AccountMember[]
  categories      Category[]
  budgetSettings  BudgetSettings?
  createdInvites  AccountInvite[] @relation("InviteCreatedBy")
  acceptedInvites AccountInvite[] @relation("InviteAcceptedBy")
  contributionPlans AccountContributionPlan[]
  incomeEntries     IncomeEntry[]
  paidTransactions Transaction[]   @relation("TransactionPaidByUser")
  attributedTransactions Transaction[] @relation("TransactionAttributedToUser")
  savingsLabels       SavingsLabel[]
  savingsAllocations SavingsAllocation[]
}

model Account {
  id                    String                 @id @default(uuid())
  name                  String
  type                  AccountType            @default(PRIVATE)
  income                Float                  @default(0)
  balance               Float                  @default(0)
  color                 String?
  icon                  String?
  isArchived            Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]
  members               AccountMember[]
  invites               AccountInvite[]
  contributionPlans     AccountContributionPlan[]
  incomeEntries         IncomeEntry[]
  savingsAllocations    SavingsAllocation[]
}

model AccountMember {
  id        String            @id @default(uuid())
  userId    String
  accountId String
  role      AccountMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
}

model Transaction {
  id                   String                @id @default(uuid())
  amount               Float
  category             String
  date                 DateTime              @default(now())
  accountId            String
  paidByUserId         String?
  attributedToUserId   String?
  description          String?
  recurringTransactionId String?
  /// Shared id for rows created as one multi-month installment plan.
  installmentGroupId   String?
  /// 1-based index within the plan (e.g. 2 of 5).
  installmentNumber    Int?
  installmentTotal     Int?
  createdAt            DateTime              @default(now())
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  paidByUser           User?                 @relation("TransactionPaidByUser", fields: [paidByUserId], references: [id], onDelete: SetNull)
  attributedToUser     User?                 @relation("TransactionAttributedToUser", fields: [attributedToUserId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@index([accountId, date])
  @@index([paidByUserId])
  @@index([attributedToUserId])
  @@index([installmentGroupId])
}

model RecurringTransaction {
  id             String               @id @default(uuid())
  amount         Float
  category       String
  description    String?
  accountId      String
  startDate      DateTime             @default(now())
  nextRun        DateTime
  dayOfMonth     Int
  monthPolicy    RecurringMonthPolicy @default(ROLL_TO_LAST_DAY)
  active         Boolean              @default(true)
  lastRun        DateTime?
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([accountId, active, nextRun])
}

model BudgetSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  monthlyIncome     Float    @default(0)
  needsPercent      Int      @default(50)
  wantsPercent      Int      @default(30)
  savingsPercent    Int      @default(20)
  savingsGoal       String?
  savingsGoalAmount Float?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id       String  @id @default(uuid())
  userId   String
  name     String
  icon     String
  type     String
  isCustom Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model AccountInvite {
  id           String   @id @default(uuid())
  accountId    String
  createdById  String
  invitedEmail String?
  tokenHash    String   @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime @default(now())
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy   User?    @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
}

model AccountContributionPlan {
  id            String   @id @default(uuid())
  userId        String
  accountId     String
  monthlyAmount Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
}

model IncomeEntry {
  id          String   @id @default(uuid())
  amount      Float
  description String?
  date        DateTime
  accountId   String
  userId      String
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([userId])
}

/// User-defined or seeded savings target names (for allocation picker).
model SavingsLabel {
  id       String  @id @default(uuid())
  userId   String
  name     String
  icon     String
  /// User-created labels can be deleted; seeded defaults cannot.
  isCustom Boolean @default(false)
  /// Hide built-in labels from picker without deleting.
  hidden   Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// Money moved to savings/investments — not counted as expenses.
model SavingsAllocation {
  id          String   @id @default(uuid())
  amount      Float
  /// Standing order / recurring transfer into investments (informational flag for the user).
  standingOrderToInvestment Boolean @default(false)
  /// Display label name (matches SavingsLabel.name when applicable).
  label       String
  description String?
  date        DateTime
  accountId   String
  userId      String
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([userId])
}
